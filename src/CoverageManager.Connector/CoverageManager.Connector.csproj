<Project Sdk="Microsoft.NET.Sdk">

  <!-- v2 (Phase 2, source consolidation): the Live Bridge consumer feed is the ONLY
       B-Book source. The MetaQuotes Manager API connector (MT5ApiReal), its managed
       wrapper references and the native MT5APIManager64.dll copy step are all gone.

       This also retires the deploy hazard documented in CLAUDE.md / docs/DEPLOYMENT.md:
       no native DLL has to be copied to the publish root any more, because nothing
       P/Invokes into one. MT5_API_AVAILABLE is likewise no longer defined. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoverageManager.Core\CoverageManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
