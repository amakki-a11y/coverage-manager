# .NET
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
.vite/

# IDE
.vs/
.vscode/
.idea/
*.swp

# Environment / secrets
.env
# Per-env .NET config — must never carry real credentials to git
appsettings.Development.json
appsettings.*.Local.json
# User Secrets lives in ~/.microsoft/usersecrets but belt-and-suspenders
secrets.json

# Claude Code scheduled-task runtime lock
.claude/scheduled_tasks.lock
# Claude Code per-machine permission allowlist — leaks dev curls + their headers
.claude/settings.local.json

# Task Master
.taskmaster/templates/

# v2 local-Postgres tooling — never commit dumps, local conn strings, or secrets
**/_dumps/
db/*.local.env
*.pgdump

# Deploy / runtime artifacts present in the server working tree — never commit.
# caddy/data holds TLS private keys + ACME account keys; publish/ is build output
# with appsettings + native DLLs; run/ holds live feed state.
/publish/
/caddy/
/run/

# OS
.DS_Store
Thumbs.db

# Scheduled-task deployment layout (see _deploy/task/README.md)
publish/
run/
caddy/
/Caddyfile
